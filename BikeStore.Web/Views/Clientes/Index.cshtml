@model IEnumerable<ClienteDto>
<div class="d-flex justify-content-between mb-3"><h1>Clientes</h1><a class="btn btn-success" asp-action="Create">Nuevo cliente</a></div><form class="row g-2 mb-3" method="get"><div class="col"><input class="form-control" name="cedula" placeholder="Cédula" /></div><div class="col"><input class="form-control" name="apellido" placeholder="Apellido" /></div><div class="col-auto"><button class="btn btn-primary">Buscar</button></div></form><table class="table table-striped bg-white"><thead><tr><th>Cédula</th><th>Cliente</th><th>Teléfono</th><th>Correo</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Cedula</td><td>@x.Nombres @x.Apellidos</td><td>@x.Telefono</td><td>@x.Correo</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.IdCliente">Editar</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.IdCliente">Eliminar</a></td></tr>}</tbody></table>
