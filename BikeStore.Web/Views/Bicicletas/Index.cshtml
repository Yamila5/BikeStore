@model IEnumerable<BicicletaDto>
@{ ViewData["Title"]="Bicicletas"; var categorias = ViewBag.Categorias as List<CategoriaDto> ?? []; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Bicicletas</h1><div><a class="btn btn-outline-secondary" asp-action="StockBajo">Stock bajo</a> <a class="btn btn-success" asp-action="Create">Nueva bicicleta</a></div></div>
<form class="row g-2 mb-3" method="get"><div class="col"><input class="form-control" name="marca" placeholder="Marca" /></div><div class="col"><input class="form-control" name="modelo" placeholder="Modelo o nombre" /></div><div class="col"><select class="form-select" name="idCategoria"><option value="">Todas las categorías</option>@foreach(var c in categorias){<option value="@c.IdCategoria">@c.Nombre</option>}</select></div><div class="col-auto"><button class="btn btn-primary">Buscar</button></div></form>
<div class="table-responsive"><table class="table table-striped bg-white"><thead><tr><th>Marca / Modelo</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Marca @x.Modelo</td><td>@x.Categoria?.Nombre</td><td>$@x.Precio.ToString("N2")</td><td>@x.Stock</td><td>@x.Estado</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.IdBicicleta">Editar</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.IdBicicleta">Eliminar</a></td></tr>}</tbody></table></div>
