@model BicicletaDto
@{ var categorias = ViewBag.Categorias as List<CategoriaDto> ?? []; }
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="IdBicicleta" type="hidden" /><div class="row g-3"><div class="col-md-6"><label asp-for="Marca" class="form-label"></label><input asp-for="Marca" class="form-control" /><span asp-validation-for="Marca" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Modelo" class="form-label"></label><input asp-for="Modelo" class="form-control" /><span asp-validation-for="Modelo" class="text-danger"></span></div><div class="col-md-4"><label asp-for="IdCategoria" class="form-label">Categoría</label><select asp-for="IdCategoria" class="form-select"><option value="">Seleccione</option>@foreach(var c in categorias){<option value="@c.IdCategoria">@c.Nombre</option>}</select></div><div class="col-md-4"><label asp-for="Precio" class="form-label"></label><input asp-for="Precio" class="form-control" type="number" step="0.01" /></div><div class="col-md-4"><label asp-for="Stock" class="form-label"></label><input asp-for="Stock" class="form-control" type="number" /></div><div class="col-md-6"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select"><option>Disponible</option><option>Agotado</option></select></div></div>
