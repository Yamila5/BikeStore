@model VentaDto
<h1>Venta #@Model.IdVenta</h1><div class="card card-body bg-white mb-3"><p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p><p><strong>Cliente:</strong> @Model.Cliente?.Nombres @Model.Cliente?.Apellidos</p><table class="table"><thead><tr><th>Bicicleta</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>@foreach(var d in Model.Detalles){<tr><td>@d.Bicicleta?.Marca @d.Bicicleta?.Modelo</td><td>@d.Cantidad</td><td>$@d.Precio.ToString("N2")</td><td>$@d.Subtotal.ToString("N2")</td></tr>}</tbody></table><div class="text-end"><div>Subtotal: $@Model.Subtotal.ToString("N2")</div><div>IVA: $@Model.IVA.ToString("N2")</div><h4>Total: $@Model.Total.ToString("N2")</h4></div></div><a class="btn btn-secondary" asp-action="Index">Volver</a>
