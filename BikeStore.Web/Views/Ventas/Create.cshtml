@model VentaDto
@{ var clientes = ViewBag.Clientes as List<ClienteDto> ?? []; var bicicletas = ViewBag.Bicicletas as List<BicicletaDto> ?? []; }
<h1>Registrar venta</h1><form method="post" class="card card-body bg-white"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="IdCliente" class="form-label">Cliente</label><select asp-for="IdCliente" class="form-select"><option value="">Seleccione un cliente</option>@foreach(var c in clientes){<option value="@c.IdCliente">@c.Nombres @c.Apellidos — @c.Cedula</option>}</select></div><h5>Productos</h5><p class="text-muted">Registre de uno a tres productos. El precio 0 toma el precio vigente de la bicicleta.</p>@for(var i=0;i<3;i++){var item = i < Model.Detalles.Count ? Model.Detalles[i] : new DetalleVentaDto { Cantidad=1 };<div class="row g-2 mb-2 border-bottom pb-2"><div class="col-md-6"><select name="Detalles[@i].IdBicicleta" class="form-select"><option value="0">Seleccione bicicleta</option>@foreach(var b in bicicletas){<option value="@b.IdBicicleta" selected="@(item.IdBicicleta == b.IdBicicleta)">@b.Marca @b.Modelo — Stock: @b.Stock — $@b.Precio</option>}</select></div><div class="col-md-3"><input name="Detalles[@i].Cantidad" class="form-control" value="@item.Cantidad" type="number" min="1" placeholder="Cantidad" /></div><div class="col-md-3"><input name="Detalles[@i].Precio" class="form-control" value="@item.Precio" type="number" min="0" step="0.01" placeholder="Precio (0=actual)" /></div></div>}<button class="btn btn-success mt-3">Registrar venta</button> <a class="btn btn-secondary mt-3" asp-action="Index">Cancelar</a></form>
