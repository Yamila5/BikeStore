@model IEnumerable<VentaDto>
@{ var clientes = ViewBag.Clientes as List<ClienteDto> ?? []; }
<div class="d-flex justify-content-between mb-3"><h1>Historial de ventas</h1><a class="btn btn-success" asp-action="Create">Registrar venta</a></div><form class="row g-2 mb-3" method="get"><div class="col-md-5"><select class="form-select" name="idCliente"><option value="">Todos los clientes</option>@foreach(var c in clientes){<option value="@c.IdCliente">@c.Nombres @c.Apellidos</option>}</select></div><div class="col-auto"><button class="btn btn-primary">Consultar</button></div></form><table class="table table-striped bg-white"><thead><tr><th>#</th><th>Fecha</th><th>Cliente</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.IdVenta</td><td>@x.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Cliente?.Nombres @x.Cliente?.Apellidos</td><td>$@x.Total.ToString("N2")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.IdVenta">Ver detalle</a></td></tr>}</tbody></table>
