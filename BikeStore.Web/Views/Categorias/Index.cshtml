@model IEnumerable<CategoriaDto>
<div class="d-flex justify-content-between mb-3"><h1>Categorías</h1><a class="btn btn-success" asp-action="Create">Nueva categoría</a></div><table class="table table-striped bg-white"><thead><tr><th>Nombre</th><th>Descripción</th><th>Activa</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Nombre</td><td>@x.Descripcion</td><td>@(x.Activo ? "Sí" : "No")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.IdCategoria">Editar</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.IdCategoria">Eliminar</a></td></tr>}</tbody></table>
